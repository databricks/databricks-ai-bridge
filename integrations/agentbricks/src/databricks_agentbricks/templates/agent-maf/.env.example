# Local model authentication. Managed bindings are resolved from agent.toml by the SDK.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional overrides for the managed Session Store and Memory Store.
# AGENT_SESSION_STORE=my-agent-sessions
# AGENT_MEMORY_STORE=my-agent-memory

# Optional tracing: configure both a destination and an experiment.
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_ID=<experiment-id>
