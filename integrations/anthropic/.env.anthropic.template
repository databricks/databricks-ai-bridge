# Template for the Claude Managed Agents + Databricks Sandbox examples.
# Copy it outside the repo (e.g. ../_local/.env_anthropic), fill it in, and `chmod 600` it.
# Never commit the filled-in copy: .gitignore excludes .env* except *.template files.

# --- Anthropic (Claude Console: https://platform.claude.com) -----------------------
# API key: Settings -> API keys -> Create key. Stays on your machine; never sent into the sandbox.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
# Self-hosted environment: https://platform.claude.com/environments -> Create environment -> Hosting: Self-hosted.
ANTHROPIC_ENVIRONMENT_ID=env_REPLACE_ME
# Environment key: open the environment -> Generate environment key (shown once, Console only).
# The only Anthropic secret that enters the sandbox; the worker uses it to claim work and post tool results.
ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-REPLACE_ME
# Optional: workspace ID (Settings -> Workspaces), only used to print clickable Console links.
ANTHROPIC_WORKSPACE_ID=wrkspc_REPLACE_ME
# Optional: set by the setup scripts once they create an agent.
ANTHROPIC_AGENT_ID=

# --- Databricks ---------------------------------------------------------------------
# CLI profile for U2M auth (`databricks auth login --host <workspace-url> --profile <name>`).
# The sandbox, and every Genie One call made from it, act as this identity.
DATABRICKS_CONFIG_PROFILE=REPLACE_ME

# --- Optional: your own Databricks OAuth app for --auth browser ----------------------
# Put these in a separate file and pass it with --oauth-env-file (or export them).
# Register redirect URL http://localhost:8020 (fixed by the Databricks SDK):
# DATABRICKS_U2M_CLIENT_ID=REPLACE_ME
# DATABRICKS_U2M_CLIENT_SECRET=REPLACE_ME
